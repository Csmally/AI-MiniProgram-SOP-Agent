# ==========================================
# 微信小程序 SOP Agent — 环境变量配置参考
# 复制为 .env 并填入真实值：cp .env.example .env
# 变量清单与 backend/sop_agent/core/config.py 保持一致
# ==========================================

# -----------------------------------------
# DeepSeek（必需）
# -----------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_LLM_URL=https://api.deepseek.com
# DEEPSEEK_V4_PRO_MODEL_NAME=deepseek-v4-pro
# DEEPSEEK_V4_FLASH_MODEL_NAME=deepseek-v4-flash

# -----------------------------------------
# Qwen（可选，截图分析用）
# -----------------------------------------
# QWEN_API_KEY=sk-your-qwen-key-here
# QWEN_LLM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN3_7_FLASH_MODEL_NAME=qwen3.7-flash

# -----------------------------------------
# 微信开发者工具（minium 自动化，已弃用待清理）
# -----------------------------------------
# MINIUM_PROJECT_PATH=C:/path/to/miniprogram/project
# MINIUM_DEV_TOOL_PATH=C:/Program Files (x86)/Tencent/微信web开发者工具/cli.bat
# MINIUM_TEST_PORT=9420
# MINIUM_ENABLED=true  # 必需：显式 true 且两项路径配齐才启用（未设置即禁用）

# -----------------------------------------
# 小程序自动化（automator sidecar，现行）
# -----------------------------------------
# AUTOMATOR_SIDECAR_URL=http://127.0.0.1:9310  # sidecar/ 目录 node server.js 的地址
# AUTOMATOR_PROJECT_PATH=C:/path/to/miniprogram/dist  # 小程序项目路径（懒拉起 DevTools 用）
# AUTOMATOR_CLI_PATH=C:/Program Files (x86)/Tencent/微信web开发者工具/cli.bat  # 开发者工具 CLI（懒拉起用）
# AUTOMATOR_PORT=9420  # DevTools 自动化端口

# -----------------------------------------
# 本地 LLM（llama.cpp，可选；开启后所有模型任务走本地）
# -----------------------------------------
# LOCAL_LLM_ENABLED=true  # true = 所有任务统一走本地 llama.cpp（忽略 DEEPSEEK_*/QWEN_* 路由）
# LOCAL_LLM_URL=http://127.0.0.1:8080/v1
# LOCAL_LLM_MODEL=Qwen3.8-27B-Q3_K_M.gguf
# LOCAL_LLM_API_KEY=local-any-value  # llama-server 不校验 key，任意非空即可

# -----------------------------------------
# PostgreSQL
# -----------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sop_agent

# -----------------------------------------
# 服务
# -----------------------------------------
# HOST=127.0.0.1
# PORT=8000
# DEBUG=true
# SESSIONS_DIR=./sessions  # 会话与截图存档目录
