# ==========================================
# 微信小程序 SOP Agent — 环境变量配置参考
# 复制为 .env 并填入真实值：cp .env.example .env
# 变量清单与 backend/sop_agent/core/config.py 保持一致
# ==========================================

# -----------------------------------------
# DeepSeek（必需）
# -----------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_LLM_URL=https://api.deepseek.com
# DEEPSEEK_V4_PRO_MODEL_NAME=deepseek-v4-pro
# DEEPSEEK_V4_FLASH_MODEL_NAME=deepseek-v4-flash

# -----------------------------------------
# Qwen（可选，截图分析用）
# -----------------------------------------
# QWEN_API_KEY=sk-your-qwen-key-here
# QWEN_LLM_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN3_7_FLASH_MODEL_NAME=qwen3.7-flash

# -----------------------------------------
# 微信开发者工具（minium 自动化）
# -----------------------------------------
# MINIUM_PROJECT_PATH=C:/path/to/miniprogram/project
# MINIUM_DEV_TOOL_PATH=C:/Program Files (x86)/Tencent/微信web开发者工具/cli.bat
# MINIUM_TEST_PORT=9420
# MINIUM_ENABLED=true  # 必需：显式 true 且两项路径配齐才启用（未设置即禁用）

# -----------------------------------------
# PostgreSQL
# -----------------------------------------
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/sop_agent

# -----------------------------------------
# 服务
# -----------------------------------------
# HOST=127.0.0.1
# PORT=8000
# DEBUG=true
# SESSIONS_DIR=./sessions  # 会话与截图存档目录
