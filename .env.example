# ==========================================
# 微信小程序 SOP Agent — 环境变量配置参考
# 复制为 .env 并填入真实值
# ==========================================

# -----------------------------------------
# 大模型提供者注册（逗号分隔）
# -----------------------------------------
LLM_PROVIDERS=deepseek-v4-pro,deepseek-v4-flash,qwen3.7-flash

# -----------------------------------------
# 通用 API Keys
# -----------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
QWEN_API_KEY=sk-your-qwen-key-here

# -----------------------------------------
# 模型路由：任务 → provider
# -----------------------------------------
LLM_TASK_PARSE_PRD=deepseek-v4-pro
LLM_TASK_GENERATE_SOP=deepseek-v4-pro
LLM_TASK_CHAT=deepseek-v4-flash
LLM_TASK_EXECUTE_CHECKS=deepseek-v4-pro
LLM_TASK_SCREENSHOT_ANALYSIS=qwen3.7-flash
LLM_TASK_GENERATE_REPORT=deepseek-v4-flash

# -----------------------------------------
# 各 Provider: LLM_<KEY大写>_MODEL / _URL / _KEY
# -----------------------------------------
LLM_DEEPSEEK_V4_PRO_MODEL=deepseek-v4-pro
LLM_DEEPSEEK_V4_PRO_URL=https://api.deepseek.com

LLM_DEEPSEEK_V4_FLASH_MODEL=deepseek-v4-flash
LLM_DEEPSEEK_V4_FLASH_URL=https://api.deepseek.com

LLM_QWEN3_7_FLASH_MODEL=qwen3.7-flash
LLM_QWEN3_7_FLASH_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# -----------------------------------------
# 微信小程序
# -----------------------------------------
# MINIUM_PROJECT_PATH=/path/to/miniprogram/project

# -----------------------------------------
# 服务
# -----------------------------------------
# HOST=127.0.0.1
# PORT=8000
# DEBUG=true
